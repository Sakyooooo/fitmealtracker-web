# Gemini API Key (server-side only — never expose to client)
# Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AIza...your_key_here

# ── Supabase（フレンド機能） ───────────────────────────────────────────────────
# Supabase プロジェクトの設定画面 > API から取得
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# ── Security: /api/analyze-meal ──────────────────────────────────────────────

# Set to "false" to completely disable the meal analysis endpoint.
# Default: enabled (as long as GEMINI_API_KEY is set)
# MEAL_ANALYSIS_ENABLED=false

# Explicit allowed origin for Origin header check.
# Required in production if VERCEL_URL is not available (e.g. custom domain).
# Example: https://your-app.vercel.app
# ALLOWED_ORIGIN=https://your-app.vercel.app
